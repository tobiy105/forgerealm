---
import BaseLayout from "../layouts/BaseLayout.astro";
import ShopNavbar from "../components/ShopNavbar";
import CustomOrderApp from "../components/CustomOrder";
---

<BaseLayout
  title="Custom Order | ForgeRealm"
  description="Request a custom 3D print from ForgeRealm. Tell us your idea and we'll bring it to life."
>
  <div
    class="relative isolate min-h-[100svh] bg-[#0a0f1a] text-white overflow-x-hidden"
  >
    <ShopNavbar client:load />
    <main class="pt-20 sm:pt-24">
      <CustomOrderApp client:load />
    </main>
  </div>
</BaseLayout>
