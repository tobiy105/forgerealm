---
import BaseLayout from "../layouts/BaseLayout.astro";
import ShopNavbar from "../components/ShopNavbar";
import CustomOrderApp from "../components/CustomOrder";
---

<BaseLayout
  title="Custom Order | ForgeRealm"
  description="Commission a custom 3D print from ForgeRealm. Describe your idea, reference a shop piece, or scan a barcode in store — we'll get back to you within 24-48 hours."
>
  <div
    class="landing-ambience relative min-h-[100svh] bg-[#0a0f1a] text-white overflow-x-hidden"
  >
    <ShopNavbar client:load />

    <main class="pt-24 sm:pt-28">
      <CustomOrderApp client:load />
    </main>
  </div>
</BaseLayout>
